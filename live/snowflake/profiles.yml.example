# Copy to live/snowflake/profiles.yml (gitignored) and export the env vars. UNVALIDATED.
# Key-pair auth is used so no password is ever stored in the repo or typed by the harness.
costci_lab:
  target: prod
  outputs:
    prod: &sf
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      authenticator: snowflake_jwt
      private_key_path: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PATH') }}"
      role: "{{ env_var('SNOWFLAKE_ROLE', 'COSTCI_ROLE') }}"
      database: COSTCI_LAB
      warehouse: COSTCI_PROD_WH
      schema: PROD
      threads: 1
      query_tag: costci
    main:
      <<: *sf
      warehouse: COSTCI_CI_WH
      schema: CI_MAIN
    pr:
      <<: *sf
      warehouse: COSTCI_CI_WH
      schema: CI_PR
