 "workloads": {
  "main": [
   {
    "id": "model:fct_daily_revenue",
    "kind": "model",
    "name": "fct_daily_revenue",
    "sql": "\n\nselect\n    l.ship_date,\n    count(*)                                                 as line_count,\n    sum(l.quantity)                                          as total_quantity,\n    sum((l.extended_price * (1 - l.discount))) as net_revenue,\n    sum(case when l.return_flag = 'R'\n             then (l.extended_price * (1 - l.discount))\n             else 0 end)                                     as returned_revenue\nfrom \"lab\".\"prod\".\"stg_lineitem\" l\nwhere l.ship_date <= cast('1998-08-02' as date)\n\n  and l.ship_date > cast(\n\n    (cast('1998-08-02' as date) + cast(-3 as bigint) * interval 1 day) as date)\n\ngroup by l.ship_date",
    "materialized": "incremental",
    "unique_key": "ship_date",
    "job": "revenue_hourly",
    "runs_per_month": 720,
    "pool": "transform_wh"
   },
   {
    "id": "model:rpt_daily_kpis",
    "kind": "model",
    "name": "rpt_daily_kpis",
    "sql": "select\n    ship_date,\n    net_revenue,\n    returned_revenue,\n    line_count,\n    avg(net_revenue) over (order by ship_date rows between 6 preceding and current row) as net_revenue_7d_avg\nfrom \"lab\".\"ci_main\".\"fct_daily_revenue\"\nwhere ship_date > cast(\n\n    (cast('1998-08-02' as date) + cast(-30 as bigint) * interval 1 day) as date)",
    "materialized": "view",
    "unique_key": null,
    "job": "daily_build",
    "runs_per_month": 30,
    "pool": "transform_wh"
   },
   {
    "id": "consumer:bi_kpi_tiles",
    "kind": "consumer",
    "name": "bi_kpi_tiles",
    "sql": "select * from \"lab\".\"ci_main\".\"rpt_daily_kpis\" order by ship_date",
    "materialized": null,
    "unique_key": null,
    "job": null,
    "runs_per_month": 30000,
    "pool": "bi_wh"
   }
  ],
  "pr": [
   {
    "id": "model:fct_daily_revenue",
    "kind": "model",
    "name": "fct_daily_revenue",
    "sql": "\n\nselect\n    l.ship_date,\n    count(*)                                                 as line_count,\n    sum(l.quantity)                                          as total_quantity,\n    sum((l.extended_price * (1 - l.discount))) as net_revenue,\n    sum(case when l.return_flag = 'R'\n             then (l.extended_price * (1 - l.discount))\n             else 0 end)                                     as returned_revenue\nfrom \"lab\".\"prod\".\"stg_lineitem\" l\nwhere l.ship_date <= cast('1998-08-02' as date)\ngroup by l.ship_date",
    "materialized": "table",
    "unique_key": null,
    "job": "revenue_hourly",
    "runs_per_month": 720,
    "pool": "transform_wh"
   },
   {
    "id": "model:rpt_daily_kpis",
    "kind": "model",
    "name": "rpt_daily_kpis",
    "sql": "select\n    ship_date,\n    net_revenue,\n    returned_revenue,\n    line_count,\n    avg(net_revenue) over (order by ship_date rows between 6 preceding and current row) as net_revenue_7d_avg\nfrom \"lab\".\"ci_pr\".\"fct_daily_revenue\"\nwhere ship_date > cast(\n\n    (cast('1998-08-02' as date) + cast(-30 as bigint) * interval 1 day) as date)",
    "materialized": "view",
