 "workloads": {
  "main": [
   {
    "id": "model:mart_part_profitability",
    "kind": "model",
    "name": "mart_part_profitability",
    "sql": "select\n    ol.part_key,\n    pc.part_name,\n    pc.brand,\n    sum(ol.quantity)                                            as quantity_sold,\n    sum(ol.net_revenue)                                         as net_revenue,\n    sum(ol.net_revenue) - sum(ol.quantity * pc.min_supply_cost) as est_margin\nfrom \"lab\".\"prod\".\"int_order_lines\" ol\njoin \"lab\".\"prod\".\"part_supplier_costs\" pc on pc.part_key = ol.part_key\ngroup by ol.part_key, pc.part_name, pc.brand",
    "materialized": "table",
    "unique_key": null,
    "job": "daily_build",
    "runs_per_month": 30,
    "pool": "transform_wh"
   }
  ],
  "pr": [
   {
    "id": "model:mart_part_profitability",
    "kind": "model",
    "name": "mart_part_profitability",
    "sql": "select\n    ol.part_key,\n    pc.part_name,\n    pc.brand,\n    sum(ol.quantity)                                            as quantity_sold,\n    sum(ol.net_revenue)                                         as net_revenue,\n    sum(ol.net_revenue) - sum(ol.quantity * pc.min_supply_cost) as est_margin,\n    avg(ps.supply_cost)                                         as avg_supplier_cost\nfrom \"lab\".\"prod\".\"int_order_lines\" ol\njoin \"lab\".\"prod\".\"part_supplier_costs\" pc on pc.part_key = ol.part_key\njoin \"lab\".\"prod\".\"stg_partsupp\" ps on ps.part_key = ol.part_key\ngroup by ol.part_key, pc.part_name, pc.brand",
    "materialized": "table",
    "unique_key": null,
    "job": "daily_build",
    "runs_per_month": 30,
    "pool": "transform_wh"
   }
  ]
 },
