 "workloads": {
  "main": [
   {
    "id": "model:mart_part_profitability",
    "kind": "model",
    "name": "mart_part_profitability",
    "sql": "select\n    ol.part_key,\n    pc.part_name,\n    pc.brand,\n    sum(ol.quantity)                                            as quantity_sold,\n    sum(ol.net_revenue)                                         as net_revenue,\n    sum(ol.net_revenue) - sum(ol.quantity * pc.min_supply_cost) as est_margin\nfrom \"lab\".\"prod\".\"int_order_lines\" ol\njoin \"lab\".\"prod\".\"part_supplier_costs\" pc on pc.part_key = ol.part_key\ngroup by ol.part_key, pc.part_name, pc.brand",
    "materialized": "table",
    "unique_key": null,
    "job": "daily_build",
    "runs_per_month": 30,
    "pool": "transform_wh"
   }
  ],
  "pr": [
   {
    "id": "model:mart_part_profitability",
    "kind": "model",
    "name": "mart_part_profitability",
    "sql": "with peer_volume as (\n    -- how busy was the ship mode on the day each line shipped\n    select a.order_key, a.line_number, count(*) as same_day_mode_lines\n    from \"lab\".\"prod\".\"int_order_lines\" a\n    join \"lab\".\"prod\".\"int_order_lines\" b\n      on b.ship_date = a.ship_date and b.ship_mode = a.ship_mode\n    group by a.order_key, a.line_number\n)\nselect\n    ol.part_key,\n    pc.part_name,\n    pc.brand,\n    sum(ol.quantity)                                            as quantity_sold,\n    sum(ol.net_revenue)                                         as net_revenue,\n    sum(ol.net_revenue) - sum(ol.quantity * pc.min_supply_cost) as est_margin,\n    avg(pv.same_day_mode_lines)                                 as avg_same_day_mode_lines\nfrom \"lab\".\"prod\".\"int_order_lines\" ol\njoin \"lab\".\"prod\".\"part_supplier_costs\" pc on pc.part_key = ol.part_key\njoin peer_volume pv on pv.order_key = ol.order_key and pv.line_number = ol.line_number\ngroup by ol.part_key, pc.part_name, pc.brand",
    "materialized": "table",
    "unique_key": null,
    "job": "daily_build",
    "runs_per_month": 30,
    "pool": "transform_wh"
   }
  ]
 },
