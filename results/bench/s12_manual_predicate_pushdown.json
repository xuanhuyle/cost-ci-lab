 "workloads": {
  "main": [
   {
    "id": "model:mart_revenue_by_nation",
    "kind": "model",
    "name": "mart_revenue_by_nation",
    "sql": "select\n    c.nation_name,\n    c.region_name,\n    date_trunc('month', ol.ship_date) as ship_month,\n    count(distinct ol.order_key)                    as order_count,\n    sum(ol.net_revenue)                             as net_revenue\nfrom \"lab\".\"prod\".\"int_order_lines\" ol\njoin \"lab\".\"prod\".\"dim_customers\" c on c.customer_key = ol.customer_key\ngroup by 1, 2, 3\nhaving date_trunc('month', ol.ship_date)\n       >= date_trunc('month', cast(\n\n    (cast('1998-08-02' as date) + cast(-3 as bigint) * interval 1 month) as date))",
    "materialized": "table",
    "unique_key": null,
    "job": "daily_build",
    "runs_per_month": 30,
    "pool": "transform_wh"
   },
   {
    "id": "consumer:bi_nation_trend",
    "kind": "consumer",
    "name": "bi_nation_trend",
    "sql": "select nation_name, ship_month, sum(net_revenue) as net_revenue from \"lab\".\"ci_main\".\"mart_revenue_by_nation\" group by 1, 2",
    "materialized": null,
    "unique_key": null,
    "job": null,
    "runs_per_month": 3000,
    "pool": "bi_wh"
   }
  ],
  "pr": [
   {
    "id": "model:mart_revenue_by_nation",
    "kind": "model",
    "name": "mart_revenue_by_nation",
    "sql": "select\n    c.nation_name,\n    c.region_name,\n    date_trunc('month', ol.ship_date) as ship_month,\n    count(distinct ol.order_key)                    as order_count,\n    sum(ol.net_revenue)                             as net_revenue\nfrom \"lab\".\"prod\".\"int_order_lines\" ol\njoin \"lab\".\"prod\".\"dim_customers\" c on c.customer_key = ol.customer_key\nwhere ol.ship_date >= date_trunc('month', cast(\n\n    (cast('1998-08-02' as date) + cast(-3 as bigint) * interval 1 month) as date))\ngroup by 1, 2, 3",
    "materialized": "table",
    "unique_key": null,
    "job": "daily_build",
    "runs_per_month": 30,
    "pool": "transform_wh"
