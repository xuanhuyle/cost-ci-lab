 "workloads": {
  "main": [
   {
    "id": "model:customer_ltv_monthly",
    "kind": "model",
    "name": "customer_ltv_monthly",
    "sql": "\n\nwith lines as (\n    select\n        o.customer_key,\n        o.order_key,\n        o.order_date,\n        (l.extended_price * (1 - l.discount)) as revenue\n    from \"lab\".\"prod\".\"stg_orders\" o\n    join \"lab\".\"prod\".\"stg_lineitem\" l on l.order_key = o.order_key\n    where o.order_date <= cast('1998-08-02' as date)\n),\nmonthly as (\n    select\n        customer_key,\n        date_trunc('month', order_date) as order_month,\n        sum(revenue)              as revenue,\n        count(distinct order_key) as order_count\n    from lines\n    group by 1, 2\n)\nselect\n    customer_key,\n    order_month,\n    revenue,\n    order_count,\n    sum(revenue) over (partition by customer_key order by order_month\n                       rows between unbounded preceding and current row) as cumulative_revenue,\n    min(order_month) over (partition by customer_key)                     as cohort_month\nfrom monthly",
    "materialized": "table",
    "unique_key": null,
    "job": "monthly_ltv",
    "runs_per_month": 1,
    "pool": "transform_wh"
   }
  ],
  "pr": [
   {
    "id": "model:customer_ltv_monthly",
    "kind": "model",
    "name": "customer_ltv_monthly",
    "sql": "\n\nwith order_revenue as (\n    -- aggregate lines to one row per order before joining\n    select order_key, sum((extended_price * (1 - discount))) as revenue\n    from \"lab\".\"prod\".\"stg_lineitem\"\n    group by order_key\n),\nlines as (\n    select o.customer_key, o.order_key, o.order_date, r.revenue\n    from \"lab\".\"prod\".\"stg_orders\" o\n    join order_revenue r on r.order_key = o.order_key\n    where o.order_date <= cast('1998-08-02' as date)\n),\nmonthly as (\n    select\n        customer_key,\n        date_trunc('month', order_date) as order_month,\n        sum(revenue)              as revenue,\n        count(distinct order_key) as order_count\n    from lines\n    group by 1, 2\n)\nselect\n    customer_key,\n    order_month,\n    revenue,\n    order_count,\n    sum(revenue) over (partition by customer_key order by order_month\n                       rows between unbounded preceding and current row) as cumulative_revenue,\n    min(order_month) over (partition by customer_key)                     as cohort_month\nfrom monthly",
    "materialized": "table",
    "unique_key": null,
    "job": "monthly_ltv",
    "runs_per_month": 1,
    "pool": "transform_wh"
   }
  ]
 },
