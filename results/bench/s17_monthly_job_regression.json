 "workloads": {
  "main": [
   {
    "id": "model:customer_ltv_monthly",
    "kind": "model",
    "name": "customer_ltv_monthly",
    "sql": "\n\nwith lines as (\n    select\n        o.customer_key,\n        o.order_key,\n        o.order_date,\n        (l.extended_price * (1 - l.discount)) as revenue\n    from \"lab\".\"prod\".\"stg_orders\" o\n    join \"lab\".\"prod\".\"stg_lineitem\" l on l.order_key = o.order_key\n    where o.order_date <= cast('1998-08-02' as date)\n),\nmonthly as (\n    select\n        customer_key,\n        date_trunc('month', order_date) as order_month,\n        sum(revenue)              as revenue,\n        count(distinct order_key) as order_count\n    from lines\n    group by 1, 2\n)\nselect\n    customer_key,\n    order_month,\n    revenue,\n    order_count,\n    sum(revenue) over (partition by customer_key order by order_month\n                       rows between unbounded preceding and current row) as cumulative_revenue,\n    min(order_month) over (partition by customer_key)                     as cohort_month\nfrom monthly",
    "materialized": "table",
    "unique_key": null,
    "job": "monthly_ltv",
    "runs_per_month": 1,
    "pool": "transform_wh"
   }
  ],
  "pr": [
   {
    "id": "model:customer_ltv_monthly",
    "kind": "model",
    "name": "customer_ltv_monthly",
    "sql": "\n\nwith lines as (\n    select\n        o.customer_key,\n        o.order_key,\n        o.order_date,\n        (l.extended_price * (1 - l.discount)) as revenue\n    from \"lab\".\"prod\".\"stg_orders\" o\n    join \"lab\".\"prod\".\"stg_lineitem\" l on l.order_key = o.order_key\n    where o.order_date <= cast('1998-08-02' as date)\n),\nmonthly as (\n    select\n        customer_key,\n        date_trunc('month', order_date) as order_month,\n        sum(revenue)              as revenue,\n        count(distinct order_key) as order_count\n    from lines\n    group by 1, 2\n)\nselect\n    customer_key,\n    order_month,\n    revenue,\n    order_count,\n    sum(revenue) over (partition by customer_key order by order_month\n                       rows between unbounded preceding and current row) as cumulative_revenue,\n    min(order_month) over (partition by customer_key)                     as cohort_month,\n    sum(revenue) over (partition by customer_key order by order_month\n                       rows between 2 preceding and current row)          as revenue_3m,\n    sum(revenue) over (partition by customer_key order by order_month\n                       rows between 11 preceding and current row)         as revenue_12m,\n    rank() over (partition by order_month order by revenue desc)          as monthly_rank,\n    ntile(10) over (partition by order_month order by revenue desc)       as monthly_decile,\n    median(revenue) over (partition by order_month)                       as monthly_median_revenue\nfrom monthly",
    "materialized": "table",
    "unique_key": null,
    "job": "monthly_ltv",
    "runs_per_month": 1,
    "pool": "transform_wh"
   }
  ]
 },
