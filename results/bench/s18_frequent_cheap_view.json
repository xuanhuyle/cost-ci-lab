   {
    "id": "bi_customer_lookup",
    "sql": "select * from {{ ref('dim_customers') }} where customer_key = 4242",
    "runs_per_month": 60000,
    "pool": "bi_wh"
   },
   {
    "id": "bi_segments_dashboard",
    "sql": "select * from {{ ref('rpt_customer_segments') }} order by customer_count desc",
    "runs_per_month": 9000,
    "pool": "bi_wh"
   },
   {
    "id": "bi_kpi_tiles",
    "sql": "select * from {{ ref('rpt_daily_kpis') }} order by ship_date",
    "runs_per_month": 30000,
    "pool": "bi_wh"
   },
   {
    "id": "bi_nation_trend",
    "sql": "select nation_name, ship_month, sum(net_revenue) as net_revenue from {{ ref('mart_revenue_by_nation') }} group by 1, 2",
    "runs_per_month": 3000,
    "pool": "bi_wh"
   }
  ],
  "pools": {
   "transform_wh": {
    "kind": "snowflake_warehouse",
    "credits_per_hour": 4,
    "price_per_credit": 3.0,
    "auto_suspend_s": 60
   },
   "bi_wh": {
    "kind": "snowflake_warehouse",
    "credits_per_hour": 2,
    "price_per_credit": 3.0,
    "auto_suspend_s": 300,
    "max_clusters": 2,
    "business_hours": [
     8,
     20
    ]
   }
  }
 },
 "workloads": {
  "main": [
   {
    "id": "model:rpt_daily_kpis",
    "kind": "model",
    "name": "rpt_daily_kpis",
    "sql": "select\n    ship_date,\n    net_revenue,\n    returned_revenue,\n    line_count,\n    avg(net_revenue) over (order by ship_date rows between 6 preceding and current row) as net_revenue_7d_avg\nfrom \"lab\".\"prod\".\"fct_daily_revenue\"\nwhere ship_date > cast(\n\n    (cast('1998-08-02' as date) + cast(-30 as bigint) * interval 1 day) as date)",
    "materialized": "view",
    "unique_key": null,
    "job": "daily_build",
    "runs_per_month": 30,
    "pool": "transform_wh"
   },
   {
    "id": "consumer:bi_kpi_tiles",
    "kind": "consumer",
    "name": "bi_kpi_tiles",
    "sql": "select * from \"lab\".\"ci_main\".\"rpt_daily_kpis\" order by ship_date",
    "materialized": null,
    "unique_key": null,
    "job": null,
    "runs_per_month": 30000,
    "pool": "bi_wh"
   }
  ],
  "pr": [
   {
    "id": "model:rpt_daily_kpis",
    "kind": "model",
    "name": "rpt_daily_kpis",
    "sql": "select\n    cur.ship_date,\n    cur.net_revenue,\n    cur.returned_revenue,\n    cur.line_count,\n    avg(cur.net_revenue) over (order by cur.ship_date rows between 6 preceding and current row)  as net_revenue_7d_avg,\n    avg(cur.net_revenue) over (order by cur.ship_date rows between 27 preceding and current row) as net_revenue_28d_avg,\n    prev.net_revenue                                                                            as net_revenue_last_year\nfrom \"lab\".\"prod\".\"fct_daily_revenue\" cur\nleft join \"lab\".\"prod\".\"fct_daily_revenue\" prev\n  on prev.ship_date = cast(\n\n    (cur.ship_date + cast(-364 as bigint) * interval 1 day) as date)\nwhere cur.ship_date > cast(\n\n    (cast('1998-08-02' as date) + cast(-30 as bigint) * interval 1 day) as date)",
    "materialized": "view",
    "unique_key": null,
    "job": "daily_build",
    "runs_per_month": 30,
    "pool": "transform_wh"
   },
   {
    "id": "consumer:bi_kpi_tiles",
    "kind": "consumer",
    "name": "bi_kpi_tiles",
    "sql": "select * from \"lab\".\"ci_pr\".\"rpt_daily_kpis\" order by ship_date",
    "materialized": null,
    "unique_key": null,
    "job": null,
    "runs_per_month": 30000,
    "pool": "bi_wh"
   }
  ]
 },
